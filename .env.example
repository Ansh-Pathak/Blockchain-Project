# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to GitHub.

# Free RPC endpoint for Sepolia testnet - sign up at alchemy.com or infura.io
SEPOLIA_RPC_URL=

# Private key of a MetaMask wallet used ONLY for testing (get free Sepolia ETH from a faucet).
# Never put a wallet's private key that holds real funds here.
PRIVATE_KEY=

# Free API key from etherscan.io/apis, used to verify contract source code on Sepolia Etherscan.
ETHERSCAN_API_KEY=
